{
  "name": "vimp-test-env",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",
  "forwardPorts": [8000],
  "postCreateCommand": "pip install -r requirements.txt && python manage.py migrate --noinput",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python"]
    }
  }
}
